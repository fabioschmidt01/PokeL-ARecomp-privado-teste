// The .exe's icon (Makefile: windres -I docs/icon). ID 1: Explorer and the taskbar use the first icon resource.
1 ICON "icon.ico"
// The application manifest (RT_MANIFEST 24, ID 1): UTF-8 as the process code page - a game files folder, or LAS Recomp's
// own folder, named with non-ASCII characters wasn't found (fopen and friends read paths in the system code page)
1 24 "windows.manifest"

1 VERSIONINFO
FILEVERSION 0,26,7,0
PRODUCTVERSION 0,26,7,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "PokeL-ARecomp - Pokémon Legends: Arceus PC Port"
            VALUE "FileVersion", "0.26.7.0"
            VALUE "InternalName", "PokeL-ARecomp"
            VALUE "LegalCopyright", "Open source native recompiler for Pokémon Legends: Arceus"
            VALUE "OriginalFilename", "PokeL-ARecomp.exe"
            VALUE "ProductName", "PokeL-ARecomp"
            VALUE "ProductVersion", "0.26.7.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
